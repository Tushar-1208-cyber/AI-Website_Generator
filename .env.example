# Database (Neon PostgreSQL) - Required
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Google Gemini AI API Key - Required for AI generation
GEMINI_API_KEY=your_gemini_api_key_here

# Clerk Authentication - Required
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Stripe SaaS Billing - Required for Live Payments & Webhooks
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRO_PRICE_ID=price_your_stripe_pro_price_id_here
STRIPE_TEAM_PRICE_ID=price_your_stripe_team_price_id_here

# Application URL - Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_URL=http://localhost:3000
